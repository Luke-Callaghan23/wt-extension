{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch",
            "label": "watch: all",
            "isBackground": true,
            "problemMatcher": {
                "owner": "webpack",
                "severity": "error",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    { "regexp": "^ERROR in (\\S+?):(\\d+):(\\d+)", "file": 1, "line": 2, "column": 3 },
                    { "regexp": "^\\s*(TS\\d+: .*)$", "message": 1 }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Compiler '.*' starting",
                    "endsPattern": "compiled .* in \\d+ ms"
                }
            },
            "presentation": { "reveal": "never" },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "type": "npm",
            "script": "watch:node",
            "label": "watch: node",
            "isBackground": true,
            "problemMatcher": {
                "owner": "webpack",
                "severity": "error",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    { "regexp": "^ERROR in (\\S+?):(\\d+):(\\d+)", "file": 1, "line": 2, "column": 3 },
                    { "regexp": "^\\s*(TS\\d+: .*)$", "message": 1 }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Compiler 'node' starting",
                    "endsPattern": "compiled .* in \\d+ ms"
                }
            },
            "presentation": { "reveal": "never" },
            "group": "build"
        },
        {
            "type": "npm",
            "script": "watch:web",
            "label": "watch: web",
            "isBackground": true,
            "problemMatcher": {
                "owner": "webpack",
                "severity": "error",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": [
                    { "regexp": "^ERROR in (\\S+?):(\\d+):(\\d+)", "file": 1, "line": 2, "column": 3 },
                    { "regexp": "^\\s*(TS\\d+: .*)$", "message": 1 }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Compiler 'web' starting",
                    "endsPattern": "compiled .* in \\d+ ms"
                }
            },
            "presentation": { "reveal": "never" },
            "group": "build"
        },
        {
            "type": "npm",
            "script": "compile",
            "label": "npm: compile",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "type": "npm",
            "script": "typecheck",
            "label": "npm: typecheck",
            "problemMatcher": "$tsc",
            "group": "build"
        }
    ]
}
